# Replace this before exposing PostgreSQL outside Docker's private network.
POSTGRES_PASSWORD=crownindex-local

# Loopback port for the Butter-compatible API. Change this when another local
# application already owns port 8080.
CROWN_INDEX_HOST_PORT=8080

# Optional but strongly recommended for enriched movie/show metadata.
# Use a TMDB v3 API key or v4 read token. CrownIndex keeps read tokens in an
# Authorization header and never passes this credential to Bitmagnet.
TMDB_API_KEY=
TMDB_ENABLED=false
CROWN_INDEX_TMDB_BATCH_SIZE=100
CROWN_INDEX_TMDB_LANGUAGE=en-US
CROWN_INDEX_TMDB_POLL_SECONDS=900
CROWN_INDEX_TMDB_TIMEOUT_SECONDS=30

# Configure indexers at http://127.0.0.1:9117, then copy Jackett's API key here.
# CrownIndex leaves polling disabled while this value is empty.
JACKETT_API_KEY=
CROWN_INDEX_JACKETT_INDEXERS=1337x,audiobookbay,yts,thepiratebay,eztv,dontorrent,nyaasi,sktorrent,polskie-torrenty
CROWN_INDEX_JACKETT_POLL_SECONDS=1800
CROWN_INDEX_JACKETT_TIMEOUT_SECONDS=300

# Resumable historical searches. These defaults avoid sources that currently
# require credentials, ignore searches, or consistently fail challenge checks.
CROWN_INDEX_BACKFILL_INDEXERS=yts,nyaasi,eztv,thepiratebay
CROWN_INDEX_BACKFILL_MIN_YEAR=1900
CROWN_INDEX_BACKFILL_RESULT_LIMIT=1000
CROWN_INDEX_BACKFILL_DELAY_SECONDS=60

# Butter/Popcorn-compatible catalogs to union. Each URL has independent
# resumable cursors. Leave empty to disable catalog backfill.
CROWN_INDEX_BUTTER_URLS=
CROWN_INDEX_BUTTER_SOURCE_ID=redcrown-fallbacks
CROWN_INDEX_BUTTER_TIMEOUT_SECONDS=60
CROWN_INDEX_BUTTER_DELAY_MILLIS=500

# FlareSolverr is used only by Jackett indexers that encounter anti-bot pages.
FLARESOLVERR_LOG_LEVEL=info

# LinuxServer Jackett container identity and timezone.
PUID=1000
PGID=1000
TZ=Etc/UTC

# DHT crawling consumes bandwidth and storage. To disable it, remove
# `--keys=dht_crawler` from the Bitmagnet command in compose.yaml.
